# Copy to .env (run.sh does this for you). Everything works offline with these defaults.

# --- AI explanations (optional) ---
# Without a key, AYU uses its built-in template explanations. The demo never depends on it.
# Get a key at https://aistudio.google.com/apikey — keep it in .env only (git ignores .env).
GEMINI_API_KEY=
# Text (explanations, the assistant) and reports/photos; each falls back down its chain when a model is busy.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
GEMINI_TIMEOUT_S=6

# --- Backend ---
API_PORT=8000
# DATABASE_URL=sqlite:///./backend/ayu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AYU_SEED=42
AYU_HISTORY_DAYS=7
# Seeds per scenario for /eval/lead-time (computed once in the background at startup)
AYU_EVAL_SEEDS=5

# --- Simulator ---
SIM_TICK_SECONDS=2
SIM_MINUTES_PER_TICK=5
SIM_AUTOSTART=true

# --- Frontend ---
WEB_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
